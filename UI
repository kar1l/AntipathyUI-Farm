local function createColumnLayout(parent, numCols, gap, order)
	local container = Instance.new("Frame")
	container.Name = "ColumnContainer"
	container.LayoutOrder = order
	container.Size = UDim2.new(1, 0, 0, 0)
	container.AutomaticSize = Enum.AutomaticSize.Y
	container.BackgroundTransparency = 1
	container.ZIndex = 10
	container.Parent = parent

	local columns = {}
	for i = 1, numCols do
		local col = Instance.new("Frame")
		col.Name = "Col" .. i
		col.Size = UDim2.new(1/numCols, -gap*(numCols-1)/numCols, 0, 0)
		col.Position = UDim2.new((i-1)/numCols, (i-1)*gap/numCols, 0, 0)
		col.AutomaticSize = Enum.AutomaticSize.Y
		col.BackgroundTransparency = 1
		col.ZIndex = 10
		col.Parent = container

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, gap)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = col

		columns[i] = col
	end

	return container, columns
end

