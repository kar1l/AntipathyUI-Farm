local _sessionStartTime = tick()
task.spawn(function()
	local frameCount = 0; local lastUpdate = tick()
	while frame.Parent do
		frameCount = frameCount + 1; local now = tick()
		if now - lastUpdate >= 0.5 then
			local fps = math.floor(frameCount / (now - lastUpdate)); frameCount = 0; lastUpdate = now
			local ping = "--"; pcall(function() local stats = game:GetService("Stats"); local ok, val = pcall(function() return stats.Network.ServerStatsItem["Data Ping"]:GetValue() end); if not ok then val = stats.PerformanceStats.Ping:GetValue() end; ping = tostring(math.floor(val)); local pn = math.floor(val); if pn > Settings.Stats.HighestPing then Settings.Stats.HighestPing = pn end end)
			local elapsed = math.floor(now - _sessionStartTime); local hrs = math.floor(elapsed/3600); local mins = math.floor((elapsed%3600)/60); local secs = elapsed%60
			local sessionStr = hrs > 0 and string.format("%d:%02d:%02d", hrs, mins, secs) or string.format("%d:%02d", mins, secs)
			local pingStr = ping == "--" and "--" or (ping.."ms")
			if statLabels.FPS then statLabels.FPS.Text = tostring(fps) end; if statLabels.Ping then statLabels.Ping.Text = pingStr end
			if statLabels.HighestPing then statLabels.HighestPing.Text = tostring(Settings.Stats.HighestPing).."ms" end; if statLabels.SessionTime then statLabels.SessionTime.Text = sessionStr end
			Settings.Stats.FPS = fps; Settings.Stats.Ping = tonumber(ping) or 0

			pcall(function()
				local aliveFolder = workspace:FindFirstChild("Alive") or workspace:FindFirstChild("alive")
				local activeCount = 0
				local totalCount = #ALT_USERNAMES

				for _, altId in ipairs(ALT_USERNAMES) do
					local aStr = tostring(altId):lower()
					local altPlayer = nil
					for _, p in ipairs(Players:GetPlayers()) do
						if p.Name:lower() == aStr or tostring(p.UserId) == aStr then
							altPlayer = p
							break
						end
					end
					if altPlayer then
						if aliveFolder and (aliveFolder:FindFirstChild(altPlayer.Name) or (altPlayer.Character and altPlayer.Character.Parent == aliveFolder)) then
							activeCount = activeCount + 1
						elseif not aliveFolder and altPlayer.Character and altPlayer.Character.Parent == workspace then
							activeCount = activeCount + 1
						end
					end
				end

				if statLabels.ActiveAlts then statLabels.ActiveAlts.Text = tostring(activeCount) end
				if statLabels.TotalAlts then statLabels.TotalAlts.Text = tostring(totalCount) end
				if statLabels.AfkAlts then statLabels.AfkAlts.Text = tostring(math.max(0, totalCount - activeCount)) end
				Settings.Stats.ActiveAlts = activeCount
				Settings.Stats.TotalAlts = totalCount
				Settings.Stats.AfkAlts = math.max(0, totalCount - activeCount)
			end)
		end
		RunService.Heartbeat:Wait()
	end
end)

local function switchTab(tabName)
	for name, tab in pairs(tabs) do if name ~= tabName then tab.Visible = false end end
	local activeTab = tabs[tabName]; activeTab.Visible = true
	activeTab.CanvasPosition = Vector2.new(0, 0)
	for _, ch in ipairs(activeTab:GetChildren()) do if ch:IsA("GuiObject") then local ot = ch.BackgroundTransparency; if ot < 1 then ch.BackgroundTransparency = 1; TweenService:Create(ch, TI_EXPAND, {BackgroundTransparency = ot}):Play() end; if ch:IsA("TextLabel") or ch:IsA("TextBox") or ch:IsA("TextButton") then local tt = ch.TextTransparency; ch.TextTransparency = 1; TweenService:Create(ch, TI_EXPAND, {TextTransparency = tt}):Play() end end end
	for name, btn in pairs(tabButtons) do
		local isActive = (name == tabName); btn:SetAttribute("IsActiveTab", isActive)
		local label = btn:FindFirstChild("Label"); if label then label.TextStrokeTransparency = isActive and 0 or 0.5 end
		local img = btn:FindFirstChild("TabImage"); if img then TweenService:Create(img, TweenInfo.new(0.15), {ImageTransparency = isActive and 0 or 0.7}):Play() end
		local cornerCol = isActive and Color3.fromRGB(120,120,120) or Color3.fromRGB(50,50,50)
		for _, child in ipairs(btn:GetChildren()) do if child.Name == "CornerLine" then TweenService:Create(child, TweenInfo.new(0.15), {BackgroundColor3 = cornerCol}):Play() end end
		TweenService:Create(tabLines[name], TweenInfo.new(0.15), {BackgroundColor3 = isActive and Color3.fromRGB(255,255,255) or Color3.fromRGB(70,70,70)}):Play()
		tabStrokes[name].Transparency = isActive and 0.3 or 1
	end
end
