			end
		end)
	end

	db.MouseEnter:Connect(function() TweenService:Create(ds, TI_FAST, {Color = Color3.fromRGB(110, 110, 125)}):Play() end)
	db.MouseLeave:Connect(function() if not expanded then TweenService:Create(ds, TI_FAST, {Color = Color3.fromRGB(50, 50, 58)}):Play() end end)
