task.spawn(function()
	local function isAltMatch(player, altIdentifier)
		if not player or not altIdentifier then return false end
		local targetStr = tostring(altIdentifier):lower()
		local playerName = tostring(player.Name):lower()
		local playerUserId = tostring(player.UserId)
		return playerName == targetStr or playerUserId == targetStr
	end

	local function checkAndAddAlt(player)
		if not player or player == LocalPlayer then return end
		if #ALT_USERNAMES == 0 then
			addBotEntry(player.UserId, player.DisplayName, player.Name)
			return
		end
		for _, altIdentifier in ipairs(ALT_USERNAMES) do
			if isAltMatch(player, altIdentifier) then
				addBotEntry(player.UserId, player.DisplayName, player.Name)
				return
			end
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		checkAndAddAlt(player)
	end
	Players.PlayerAdded:Connect(checkAndAddAlt)
	Players.PlayerRemoving:Connect(function(player)
		if player ~= LocalPlayer then
			removeBotEntry(player.UserId)
		end
	end)
end)

