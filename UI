local function addBotEntry(userId, displayName, username)
	for _, e in ipairs(botEntries) do
		if e.userId == userId then return e end
	end
	if not botCols then
		table.insert(pendingBots, {userId = userId, displayName = displayName, username = username})
		return nil
	end

	local targetCol = botCols[nextBotCol]
	nextBotCol = (nextBotCol % 3) + 1
	return createBotCard(targetCol, userId, displayName, username)
end

local function removeBotEntry(userId)
	for i, e in ipairs(botEntries) do
		if e.userId == userId then
			e.frame:Destroy()
			table.remove(botEntries, i)
			break
		end
	end
end

