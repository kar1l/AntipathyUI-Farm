	local descLbl = Instance.new("TextLabel")
	descLbl.BackgroundTransparency = 1
	descLbl.Size = UDim2.new(1, -40, 0, 16)
	descLbl.Position = UDim2.new(0, 16, 0, 33)
	descLbl.Text = description
	descLbl.TextColor3 = Color3.fromRGB(130, 130, 140)
	descLbl.Font = Enum.Font.GothamMedium
	descLbl.TextSize = 13
	descLbl.TextXAlignment = Enum.TextXAlignment.Left
	descLbl.TextTruncate = Enum.TextTruncate.AtEnd
	descLbl.ZIndex = 12
	descLbl.Parent = header

	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.new(0, 18, 0, 18)
	arrow.Position = UDim2.new(1, -26, 0, 10)
	arrow.Text = "▼"
	arrow.TextColor3 = Color3.fromRGB(100, 100, 105)
	arrow.Font = Enum.Font.GothamBold
	arrow.TextSize = 12
	arrow.ZIndex = 12
	arrow.Parent = header

	local statusDot, statusText
	if hasToggle then
		statusDot = Instance.new("Frame")
		statusDot.Size = UDim2.new(0, 7, 0, 7)
		statusDot.Position = UDim2.new(0, 16, 0, 64)
		statusDot.BackgroundColor3 = isEnabled and Color3.fromRGB(80, 220, 80) or Color3.fromRGB(200, 60, 60)
		statusDot.BorderSizePixel = 0
		statusDot.ZIndex = 12
		statusDot.Parent = header
		Instance.new("UICorner", statusDot).CornerRadius = UDim.new(1, 0)

		statusText = Instance.new("TextLabel")
		statusText.BackgroundTransparency = 1
		statusText.Size = UDim2.new(0, 48, 0, 16)
		statusText.Position = UDim2.new(0, 28, 0, 59)
		statusText.Text = isEnabled and "Active" or "Off"
		statusText.TextColor3 = isEnabled and Color3.fromRGB(80, 220, 80) or Color3.fromRGB(200, 60, 60)
		statusText.Font = Enum.Font.Code
		statusText.TextSize = 12
		statusText.TextXAlignment = Enum.TextXAlignment.Left
		statusText.ZIndex = 12
		statusText.Parent = header
	end

	local keybindBtn, keybindId
	if hasToggle and opts.keybindTbl and opts.keybindKey then
		local currentKeyName = opts.keybindTbl[opts.keybindKey]
		local isBinding = false
		keybindBtn = Instance.new("TextButton")
		keybindBtn.Size = UDim2.new(0, 40, 0, 18)
		keybindBtn.Position = UDim2.new(0, 82, 0, 58)
		keybindBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
		keybindBtn.Text = (currentKeyName ~= nil and currentKeyName ~= "") and currentKeyName or "..."
		keybindBtn.Font = Enum.Font.Code
		keybindBtn.TextSize = 11
		keybindBtn.TextColor3 = Color3.fromRGB(130, 130, 138)
		keybindBtn.AutoButtonColor = false
		keybindBtn.BorderSizePixel = 0
		keybindBtn.ZIndex = 14
		keybindBtn.Parent = header
		Instance.new("UICorner", keybindBtn).CornerRadius = UDim.new(0, 4)

		local bindConn
		keybindBtn.MouseButton1Click:Connect(function()
			if isBinding then
				isBinding = false
				keybindBtn.TextColor3 = Color3.fromRGB(130, 130, 138)
				if bindConn then bindConn:Disconnect(); bindConn = nil end
				return
			end
			isBinding = true
			keybindBtn.Text = ">>>"
			keybindBtn.TextColor3 = Color3.fromRGB(255, 200, 50)

			bindConn = UserInputService.InputBegan:Connect(function(input, gp)
				if gp then return end
				if input.UserInputType == Enum.UserInputType.Keyboard then
					isBinding = false
					keybindBtn.Text = input.KeyCode.Name
					keybindBtn.TextColor3 = Color3.fromRGB(190, 190, 195)
					if bindConn then bindConn:Disconnect(); bindConn = nil end

					if keybindId then
						for i, e in ipairs(_keybindRegistry) do
							if e.id == keybindId then table.remove(_keybindRegistry, i); break end
						end
					end
					keybindId = sectionTitle .. "_keybind"
					opts.keybindTbl[opts.keybindKey] = input.KeyCode.Name
					table.insert(_keybindRegistry, {
						id = keybindId,
						keyCode = input.KeyCode,
						callback = function()
							if hasToggle then
								setEnabled(not isEnabled)
								if onToggle then onToggle(isEnabled) end
							end
						end
					})
				end
			end)
		end)
	end

	local toggleBg, toggleKnob, toggleStroke
	if hasToggle then
		toggleBg = Instance.new("TextButton")
		toggleBg.Size = UDim2.new(0, 34, 0, 18)
		toggleBg.Position = UDim2.new(1, -44, 0, 58)
		toggleBg.BackgroundColor3 = isEnabled and Color3.fromRGB(60, 60, 65) or Color3.fromRGB(25, 25, 28)
		toggleBg.Text = ""
		toggleBg.AutoButtonColor = false
		toggleBg.ZIndex = 13
		toggleBg.Parent = header
		Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(0, 4)
		toggleStroke = Instance.new("UIStroke")
		toggleStroke.Color = isEnabled and Color3.fromRGB(200, 200, 205) or Color3.fromRGB(75, 75, 80)
		toggleStroke.Thickness = 1
		toggleStroke.Parent = toggleBg

		toggleKnob = Instance.new("Frame")
		toggleKnob.Size = UDim2.new(0, 14, 0, 14)
		toggleKnob.Position = isEnabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
		toggleKnob.BackgroundColor3 = isEnabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 140)
		toggleKnob.ZIndex = 14
		toggleKnob.Parent = toggleBg
		Instance.new("UICorner", toggleKnob).CornerRadius = UDim.new(0, 3)
	end

	local settingsFrame = Instance.new("Frame")
	settingsFrame.Name = "Settings"
	settingsFrame.Size = UDim2.new(1, -16, 0, 0)
	settingsFrame.Position = UDim2.new(0, 8, 0, HEADER_H + 6)
	settingsFrame.BackgroundTransparency = 1
	settingsFrame.ZIndex = 10
	settingsFrame.Parent = section

	settingsLayout = Instance.new("UIListLayout")
	settingsLayout.Padding = UDim.new(0, 8)
	settingsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	settingsLayout.Parent = settingsFrame

	local function setExpanded(expand)
		if isExpanded == expand then return end
		isExpanded = expand
		section:SetAttribute("IsExpanded", isExpanded)
		local targetH = isExpanded and (HEADER_H + 8 + settingsLayout.AbsoluteContentSize.Y + 12) or HEADER_H
		arrow.Text = isExpanded and "▲" or "▼"
		if not isExpanded then section.ClipsDescendants = true end
		local tween = TweenService:Create(section, TI_EXPAND, {Size = UDim2.new(1, 0, 0, targetH)})
		tween:Play()
		if isExpanded then
			task.spawn(function()
				tween.Completed:Wait()
				if section:GetAttribute("IsExpanded") then section.ClipsDescendants = false end
			end)
		end
		TweenService:Create(arrow, TweenInfo.new(0.15), {TextColor3 = isExpanded and Color3.fromRGB(220, 220, 220) or Color3.fromRGB(100, 100, 100)}):Play()
	end

	settingsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		local contentH = settingsLayout.AbsoluteContentSize.Y
		settingsFrame.Size = UDim2.new(1, -16, 0, contentH)
		if isExpanded then
			TweenService:Create(section, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, HEADER_H + 8 + contentH + 12)}):Play()
		end
	end)

	header.MouseButton1Click:Connect(function() setExpanded(not isExpanded) end)

	local function setEnabled(enabled)
		if not hasToggle then return end
		isEnabled = enabled
		if tbl then tbl[enabledKey] = isEnabled end
		TweenService:Create(toggleKnob, TI_NORMAL, {Position = isEnabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = isEnabled and Color3.fromRGB(255,255,255) or Color3.fromRGB(140,140,140)}):Play()
		TweenService:Create(toggleBg, TI_NORMAL, {BackgroundColor3 = isEnabled and Color3.fromRGB(60,60,65) or Color3.fromRGB(25,25,28)}):Play()
		TweenService:Create(toggleStroke, TI_NORMAL, {Color = isEnabled and Color3.fromRGB(200,200,205) or Color3.fromRGB(75,75,80)}):Play()
		TweenService:Create(section, TI_NORMAL, {BackgroundTransparency = isEnabled and 0.15 or 0.45}):Play()
		TweenService:Create(titleLbl, TI_NORMAL, {TextColor3 = isEnabled and Color3.fromRGB(255,255,255) or Color3.fromRGB(185,185,190)}):Play()
		TweenService:Create(accentLine, TI_NORMAL, {BackgroundTransparency = isEnabled and 0.3 or 1}):Play()
		if statusDot then TweenService:Create(statusDot, TI_NORMAL, {BackgroundColor3 = isEnabled and Color3.fromRGB(80,220,80) or Color3.fromRGB(200,60,60)}):Play() end
		if statusText then
			statusText.Text = isEnabled and "Active" or "Off"
			TweenService:Create(statusText, TI_NORMAL, {TextColor3 = isEnabled and Color3.fromRGB(80,220,80) or Color3.fromRGB(200,60,60)}):Play()
		end
		for _, c in ipairs(corners) do
			TweenService:Create(c, TI_NORMAL, {BackgroundColor3 = isEnabled and Color3.fromRGB(130,130,135) or Color3.fromRGB(50,50,55)}):Play()
		end
	end

	if hasToggle then
		toggleBg.MouseButton1Click:Connect(function()
			setEnabled(not isEnabled)
			if onToggle then onToggle(isEnabled) end
		end)
	end

	return settingsFrame, section, setEnabled
end

local function createSwitch(text, order, parent, tbl, key, callback)
	local isOn = tbl and tbl[key] or false
	local c = Instance.new("Frame"); c.LayoutOrder = order; c.Size = UDim2.new(1,0,0,30); c.BackgroundTransparency = 1; c.ZIndex = 10; c.Parent = parent
	local lb = Instance.new("TextLabel"); lb.BackgroundTransparency = 1; lb.Size = UDim2.new(1,-40,1,0); lb.Text = text; lb.TextColor3 = Color3.fromRGB(210,210,215); lb.Font = Enum.Font.GothamMedium; lb.TextSize = 14; lb.TextXAlignment = Enum.TextXAlignment.Left; lb.ZIndex = 10; lb.Parent = c
	local bg = Instance.new("TextButton"); bg.Size = UDim2.new(0,34,0,18); bg.Position = UDim2.new(1,-34,0.5,-9); bg.BackgroundColor3 = isOn and Color3.fromRGB(60,60,65) or Color3.fromRGB(25,25,28); bg.Text = ""; bg.AutoButtonColor = false; bg.ZIndex = 11; bg.Parent = c; Instance.new("UICorner", bg).CornerRadius = UDim.new(0,4)
	local ss = Instance.new("UIStroke"); ss.Color = isOn and Color3.fromRGB(200,200,205) or Color3.fromRGB(75,75,80); ss.Thickness = 1; ss.Parent = bg
	local kn = Instance.new("Frame"); kn.Size = UDim2.new(0,14,0,14); kn.Position = isOn and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7); kn.BackgroundColor3 = isOn and Color3.fromRGB(255,255,255) or Color3.fromRGB(140,140,140); kn.ZIndex = 12; kn.Parent = bg; Instance.new("UICorner", kn).CornerRadius = UDim.new(0,3)

	local function setSwitch(state, skipCallback)
		isOn = state
		if tbl then tbl[key] = isOn end
		TweenService:Create(kn, TI_NORMAL, {Position=isOn and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7), BackgroundColor3=isOn and Color3.fromRGB(255,255,255) or Color3.fromRGB(140,140,140)}):Play()
		TweenService:Create(bg, TI_NORMAL, {BackgroundColor3=isOn and Color3.fromRGB(60,60,65) or Color3.fromRGB(25,25,28)}):Play()
		TweenService:Create(ss, TI_NORMAL, {Color=isOn and Color3.fromRGB(200,200,205) or Color3.fromRGB(75,75,80)}):Play()
		if not skipCallback and callback then callback(isOn) end
	end

	bg.MouseButton1Click:Connect(function() setSwitch(not isOn) end)
	return {frame = c, setEnabled = setSwitch}
end

